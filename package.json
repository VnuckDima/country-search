{
  "name": "country-search",
  "version": "1.0.0",
  "description": "Live country search via countries.dev with AbortController race-condition handling",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": ["eslint --fix", "prettier --write"]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.5",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
